# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de correo). Si se deja vacio, el correo no se envia
# pero el formulario sigue funcionando y lo indica en pantalla.
RESEND_API_KEY=
RESEND_FROM_EMAIL=reportes@mysterfoodie.com

# Correo al que se envia el resultado cuando el negocio no tiene
# correo registrado (fallback).
ADMIN_EMAIL=

# Numero de WhatsApp del admin (solo digitos, con codigo de pais,
# ej. 5215512345678) para el boton "Solicitar reporte completo"
# en la pagina publica del reporte.
ADMIN_CONTACT_WHATSAPP=

# URL publica de esta app, usada para construir el link corto del
# reporte y los links de invitacion (ej. https://app.mysterfoodie.com).
# IMPORTANTE: usar APP_URL (sin el prefijo NEXT_PUBLIC_) porque en
# GoDaddy las variables NEXT_PUBLIC_* se "hornean" vacias en el build
# (los Secrets solo estan disponibles en runtime, no durante el build).
# Si se deja vacio se intenta usar el origen de la peticion, pero en
# GoDaddy eso puede resolver a una direccion interna en vez del
# dominio publico - por eso conviene fijarla explicitamente.
APP_URL=
NEXT_PUBLIC_APP_URL=
