# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de correo). Si se deja vacio, el correo no se envia
# pero el formulario sigue funcionando y lo indica en pantalla.
RESEND_API_KEY=
RESEND_FROM_EMAIL=reportes@mysterfoodie.com

# Correo al que se envia el resultado cuando el negocio no tiene
# correo registrado (fallback).
ADMIN_EMAIL=

# Numero de WhatsApp del admin (solo digitos, con codigo de pais,
# ej. 5215512345678) para el boton "Solicitar reporte completo"
# en la pagina publica del reporte.
ADMIN_CONTACT_WHATSAPP=

# URL publica de esta app, usada para construir el link corto del
# reporte y los links de invitacion (ej. https://app.mysterfoodie.com).
# IMPORTANTE: usar APP_URL (sin el prefijo NEXT_PUBLIC_) porque en
# GoDaddy las variables NEXT_PUBLIC_* se "hornean" vacias en el build
# (los Secrets solo estan disponibles en runtime, no durante el build).
# Si se deja vacio se intenta usar el origen de la peticion, pero en
# GoDaddy eso puede resolver a una direccion interna en vez del
# dominio publico - por eso conviene fijarla explicitamente.
APP_URL=
NEXT_PUBLIC_APP_URL=

# Short.io (acortador de links). El link publico del reporte que se le
# comparte al negocio se genera en go.mysterfoodie.com via la API de
# Short.io. Si se deja vacio, el flujo sigue funcionando pero usa el
# link interno de la app (APP_URL/r/codigo) en vez de uno de
# go.mysterfoodie.com.
SHORTIO_API_KEY=
SHORTIO_DOMAIN=go.mysterfoodie.com

# MercadoPago (Checkout Pro) - cobra el reporte completo desde el link
# publico del reporte (/r/codigo). Access Token de produccion, se
# consigue en el panel de MercadoPago > Tu negocio > Configuracion >
# Credenciales (o "Tus integraciones" > la app > Credenciales de
# produccion). Si se deja vacio, el reporte muestra el fallback de
# WhatsApp (ADMIN_CONTACT_WHATSAPP) en vez del boton de pago.
MERCADOPAGO_ACCESS_TOKEN=

# Precio del reporte completo en pesos mexicanos. Si se deja vacio usa
# 850 por default.
FULL_REPORT_PRICE_MXN=850
